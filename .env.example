# Public Supabase configuration. Never put privileged keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service/secret key; never commit .env.local.
SUPABASE_SECRET_KEY=

# Canonical application origin, HTTPS in production; no trailing path.
APP_URL=http://localhost:3000
# Server-only random 32-byte base64url key for short-lived recovery cookies.
AUTH_COOKIE_SECRET=
