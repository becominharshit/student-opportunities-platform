# C02 builds and runs without these values. Leave unknown values blank.
# Future Supabase Auth: project URL and public publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/worker ONLY. Never prefix with NEXT_PUBLIC_ or import into client code.
# Not consumed by C02. Set only when privileged operations exist.
SUPABASE_SERVICE_ROLE_KEY=

